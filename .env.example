# Přihlášení do administrace (/admin) účtem Google.
# Hodnoty se vytvářejí v Google Cloud Console → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Web application.
# Authorized redirect URI musí být:
#   https://www.mlynnapile.cz/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google   (pro vývoj)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Náhodný podpisový klíč sezení: vygenerovat příkazem `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Adresa webu (na Vercelu se dá vynechat, jinak nastavit na produkční doménu)
NEXTAUTH_URL=https://www.mlynnapile.cz

# Kdo se smí do administrace přihlásit (čárkou oddělené e-maily).
# Bez nastavení platí j.traxmandl@gmail.com.
ADMIN_EMAILS=j.traxmandl@gmail.com
